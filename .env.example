# Copy this file to .env (which is gitignored) and adjust values for your machine.
# Used by: deployment/generate_descriptions.py to automatically generate AI descriptions for new analysis pages.

# Ollama HTTP endpoint (default matches standard local install)
# Required if you want to generate new AI descriptions when updating data.
# Example: http://localhost:11434
OLLAMA_URL=http://localhost:11434

# Model to use for description generation
# Example: llama3, mistral, gemma2, etc. (Must be pulled locally via `ollama pull`)
OLLAMA_MODEL=llama3
